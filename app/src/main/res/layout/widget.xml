<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wifiLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/network_wifi"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/wifiStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/wifiPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/wifiStripe"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="3dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/mobileLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/network_mobile"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/mobileStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/mobilePercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/mobileStripe"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="3dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"/>

    <Button
        android:id="@+id/refreshButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/want_internet"
        android:background="@drawable/button_background"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textSize="11sp"
        android:minHeight="0dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"/>
</LinearLayout>
